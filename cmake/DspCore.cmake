# Build only from a pinned local checkout; do not modify that checkout.
set(DSP56300_ROOT "$ENV{DSP56300_ROOT}" CACHE PATH "Pinned dsp56300 source checkout")
if(NOT DSP56300_ROOT)
  set(DSP56300_ROOT "$ENV{HOME}/Git/dsp56300")
endif()
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${DSP56300_ROOT}" rev-parse HEAD
  OUTPUT_VARIABLE BLOFELD_DSP_REVISION OUTPUT_STRIP_TRAILING_WHITESPACE
  COMMAND_ERROR_IS_FATAL ANY)
if(NOT BLOFELD_DSP_REVISION STREQUAL "3ff6610d5018d798f35bc784696f3384ade0e3c4")
  message(FATAL_ERROR "DSP56300_ROOT must contain the revision pinned in doc/dependencies.json")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${DSP56300_ROOT}" diff --exit-code HEAD -- source
  RESULT_VARIABLE BLOFELD_DSP_DIRTY OUTPUT_QUIET ERROR_QUIET)
if(NOT BLOFELD_DSP_DIRTY EQUAL 0)
  message(FATAL_ERROR "The pinned DSP source tree has tracked modifications")
endif()
set(BLOFELD_DSP_COPY "${CMAKE_CURRENT_BINARY_DIR}/generated/dsp56300")
set(BLOFELD_DSP_PATCH "${CMAKE_CURRENT_SOURCE_DIR}/patches/dsp56300-reference-bus.patch")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${BLOFELD_DSP_PATCH}")
file(SHA256 "${BLOFELD_DSP_PATCH}" BLOFELD_DSP_PATCH_HASH)
set(BLOFELD_DSP_STAMP "${BLOFELD_DSP_COPY}/patch.sha256")
set(BLOFELD_DSP_COPIED_HASH "")
if(EXISTS "${BLOFELD_DSP_STAMP}")
  file(READ "${BLOFELD_DSP_STAMP}" BLOFELD_DSP_COPIED_HASH)
endif()
if(NOT BLOFELD_DSP_COPIED_HASH STREQUAL BLOFELD_DSP_PATCH_HASH)
  set(BLOFELD_DSP_STAGE "${CMAKE_CURRENT_BINARY_DIR}/generated/dsp56300-stage")
  file(MAKE_DIRECTORY "${BLOFELD_DSP_STAGE}/source")
  foreach(component dsp56kEmu dsp56kBase asmjit)
    file(COPY "${DSP56300_ROOT}/source/${component}" DESTINATION "${BLOFELD_DSP_STAGE}/source")
  endforeach()
  file(COPY "${DSP56300_ROOT}/LICENSE.md" DESTINATION "${BLOFELD_DSP_STAGE}")
  execute_process(COMMAND "${BLOFELD_PATCH}" --batch --silent -p1
    --directory "${BLOFELD_DSP_STAGE}" --input "${BLOFELD_DSP_PATCH}"
    COMMAND_ERROR_IS_FATAL ANY)
  file(GLOB_RECURSE BLOFELD_DSP_STAGED_FILES RELATIVE "${BLOFELD_DSP_STAGE}"
    "${BLOFELD_DSP_STAGE}/*")
  foreach(relative IN LISTS BLOFELD_DSP_STAGED_FILES)
    get_filename_component(parent "${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${BLOFELD_DSP_COPY}/${parent}")
    file(COPY_FILE "${BLOFELD_DSP_STAGE}/${relative}" "${BLOFELD_DSP_COPY}/${relative}" ONLY_IF_DIFFERENT)
  endforeach()
  file(WRITE "${BLOFELD_DSP_STAMP}" "${BLOFELD_DSP_PATCH_HASH}")
endif()
set(ASMJIT_STATIC ON)
set(ASMJIT_TEST OFF)
add_subdirectory("${BLOFELD_DSP_COPY}/source/asmjit" "dsp-asmjit" EXCLUDE_FROM_ALL)
file(GLOB BLOFELD_DSP_FILES "${BLOFELD_DSP_COPY}/source/dsp56kEmu/*.cpp")
list(FILTER BLOFELD_DSP_FILES EXCLUDE REGEX "(unittests|assemblertest|optimizertests|dspthread)\\.cpp$")
file(GLOB BLOFELD_DSP_BASE_FILES "${BLOFELD_DSP_COPY}/source/dsp56kBase/*.cpp")
list(FILTER BLOFELD_DSP_BASE_FILES EXCLUDE REGEX "_test\\.cpp$")
add_library(blofeld_dsp_native STATIC ${BLOFELD_DSP_FILES} ${BLOFELD_DSP_BASE_FILES})
target_include_directories(blofeld_dsp_native SYSTEM PUBLIC "${BLOFELD_DSP_COPY}/source")
target_compile_definitions(blofeld_dsp_native PUBLIC DSP56K_FORCE_INTERPRETER=1 DSP56300_DEBUGGER=0)
target_compile_options(blofeld_dsp_native PRIVATE -O1 -fconstexpr-steps=100000000)
if(BLOFELD_FUZZING)
  target_compile_options(blofeld_dsp_native PRIVATE -fsanitize=fuzzer-no-link)
endif()
find_package(Threads REQUIRED)
target_link_libraries(blofeld_dsp_native PUBLIC asmjit Threads::Threads ${CMAKE_DL_LIBS} rt)
foreach(dependency blofeld_dsp_native asmjit)
  if(DEFINED blofeld_dependency_sanitizers)
    target_compile_options(${dependency} PRIVATE
      "-fsanitize=${blofeld_dependency_sanitizers}" -fno-sanitize-recover=all -fno-omit-frame-pointer -g)
  endif()
endforeach()
