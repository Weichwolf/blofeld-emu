if(NOT BUILD_TESTING)
  return()
endif()
add_executable(blofeld-telemetry-test test/telemetry_test.cpp)
target_include_directories(blofeld-telemetry-test PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src")
target_link_libraries(blofeld-telemetry-test PRIVATE blofeld_quality)
add_test(NAME telemetry_lazy_output COMMAND blofeld-telemetry-test)
add_executable(blofeld-nand-telemetry-test test/nand_telemetry_test.cpp)
target_link_libraries(blofeld-nand-telemetry-test PRIVATE blofeld_nand_peer)
add_test(NAME nand_telemetry_equivalence COMMAND blofeld-nand-telemetry-test)
set_tests_properties(telemetry_lazy_output nand_telemetry_equivalence PROPERTIES TIMEOUT 60)
if(TARGET quality)
  add_dependencies(quality blofeld-telemetry-test blofeld-nand-telemetry-test)
endif()
