+	void DSP::alu_mpysuuu(bool ab, TReg24 s1, TReg24 s2, bool negative, bool accumulate, bool bothUnsigned)
+	{
+		const TInt64 first = bothUnsigned ? static_cast<TInt64>(s1.var & 0xffffff) : s1.signextend<TInt64>();
+		const TInt64 second = s2.var & 0xffffff;
+		const TInt64 product = first * second * 2;
+		TInt64 value = negative ? -product : product;
+		if(accumulate) value += (ab ? reg.b : reg.a).var >> g_aluShift;
+		commitArithmeticValue(ab, value, false, false);
+	}
