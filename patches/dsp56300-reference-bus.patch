+	bool DSP::referenceRepeatTarget(const TWord opcode) const
+	{
+		// FM13-160/A.3.8: only a single-word, non-flow instruction may follow REP.
+		Instruction a, b;
+		if(!m_opcodes.getInstructionTypes(opcode, a, b)) return false;
+		const auto forbidden = OpFlagBranch | OpFlagLoop | OpFlagDoLoop | OpFlagPushPC | OpFlagPopPC;
+		return m_opcodes.getOpcodeLength(opcode, a, b) == 1 &&
+			!(m_opcodes.getFlags(a, b) & forbidden) && a != Stop && a != Wait &&
+			a != Trap && a != Trapcc && a != Debug && a != Debugcc && a != Illegal;
+	}
+
+	uint32_t DSP::referenceNextCycles() const
+	{
+		verifyReferenceCheckpoint();
+		const auto pc = reg.pc.toWord();
+		TWord opcode, extension;
+		if(m_referenceRepeat.remaining && m_referenceRepeat.loaded)
+			opcode = m_referenceRepeat.opcode;
+		else
+			mem.getOpcode(pc, opcode, extension);
+		if(m_referenceRepeat.remaining && !referenceRepeatTarget(opcode))
+			throw std::runtime_error("Unsupported reference REP target");
+		return referenceCycleCost(pc, opcode);
+	}
+
+	void DSP::execReference()
+	{
+		m_referenceMode = true;
+		auto& repeat = m_referenceRepeat;
+		const bool repeated = repeat.remaining != 0;
+		if(repeated) {
+			pcCurrentInstruction = repeat.body;
+			m_srCurrentInstruction = reg.sr.toWord();
+			reg.pc.var = repeat.body;
+			if(!repeat.loaded) {
+				repeat.opcode = fetchPC();
+				repeat.extension = 0;
+			} else {
+				++reg.pc.var;
+				m_opWordB = 0;
+			}
+			if(!referenceRepeatTarget(repeat.opcode))
+				throw std::runtime_error("Unsupported reference REP target");
+			execOp(repeat.opcode);
+			notifyProgramMemWrite(repeat.body); // A latched REP must not retain a stale opcode cache entry.
+			const auto next = repeat.body + m_currentOpLen;
+			if(reg.pc.toWord() != next)
+				throw std::runtime_error("Unsupported branch/control flow in reference REP");
+			repeat.next = next;
+			repeat.loaded = true;
+			if(--repeat.remaining) {
+				reg.lc.var = repeat.remaining;
+				reg.pc.var = repeat.body;
+				return;
+			}
+			reg.lc = repeat.savedLC;
+			repeat.loaded = false;
+			m_referenceRepeatCompleted = true;
+		} else {
+			m_referenceRepeatCompleted = false;
+			execInterpreter();
+		}
+		if(sr_test_noCache(SR_LF) && pcCurrentInstruction + m_currentOpLen == reg.la.toWord() + 1 &&
+			reg.pc.toWord() == reg.la.toWord() + 1) {
+			if(!sr_test_noCache(SR_FV) && reg.lc.var <= 1) {
+				do_end();
+			} else {
+				if(!sr_test_noCache(SR_FV)) --reg.lc.var;
+				setPC(hiword(reg.ss[ssIndex()]));
+			}
+		}
+	}
