+	void DSP::alu_mpy(bool ab, const TReg24& s1, const TReg24& s2, bool negative, bool accumulate, bool rounded)
+	{
+		const TInt64 product = s1.signextend<TInt64>() * s2.signextend<TInt64>() * 2;
+		TInt64 value = negative ? -product : product;
+		if(accumulate) value += (ab ? reg.b : reg.a).var >> g_aluShift;
+		commitArithmeticValue(ab, value, rounded);
+	}
