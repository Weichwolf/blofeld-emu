+	DSP::ReferenceAddressCalculation DSP::calculateReferenceAddress(const TWord mode, const TWord index, const bool dual)
+	{
+		verifyReferenceCheckpoint();
+		if(mode > (dual ? 3u : 4u) || index >= reg.r.size())
+			throw std::runtime_error("Unqualified native reference address-generation form");
+		const auto saved = reg.r[index];
+		TWord address = 0;
+		try {
+			if(dual) address = decode_XMove_MMRRR(mode, index);
+			else switch(mode) {
+			case 0: address = decode_MMMRRR_read<0>(index); break;
+			case 1: address = decode_MMMRRR_read<1>(index); break;
+			case 2: address = decode_MMMRRR_read<2>(index); break;
+			case 3: address = decode_MMMRRR_read<3>(index); break;
+			case 4: address = decode_MMMRRR_read<4>(index); break;
+			}
+		} catch(...) { reg.r[index] = saved; throw; }
+		const auto after = reg.r[index].toWord();
+		reg.r[index] = saved;
+		return {address, saved.toWord(), after};
+	}
