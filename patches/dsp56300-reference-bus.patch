+	void DSP::restoreReferenceAttempt(const ReferenceAttemptState& state)
+	{
+		verifyReferenceCheckpoint();
+		m_referenceRedirected = false;
+		reg.x.var = state.registers.x;
+		reg.y.var = state.registers.y;
+		reg.a.var = state.registers.a;
+		reg.b.var = state.registers.b;
+		reg.sr.var = state.registers.sr;
+		reg.omr.var = state.registers.omr;
+		reg.pc.var = state.registers.pc;
+		reg.la.var = state.registers.la;
+		reg.lc.var = state.registers.lc;
+		reg.sp.var = state.registers.sp;
+		reg.sz.var = state.registers.sz;
+		reg.vba.var = state.registers.vba;
+		reg.ep.var = state.registers.ep;
+		reg.sc.var = state.registers.sc;
+		for(size_t i = 0; i < reg.r.size(); ++i) {
+			reg.r[i].var = state.registers.r[i];
+			reg.n[i].var = state.registers.n[i];
+			reg.m[i].var = state.registers.m[i];
+			reg.mMask[i] = state.registers.mMask[i];
+			reg.mModulo[i] = state.registers.mModulo[i];
+		}
+		for(size_t i = 0; i < reg.ss.size(); ++i) reg.ss[i].var = state.registers.ss[i];
+		resetCCRCache();
+		m_referenceRepeat.remaining = state.repeat.remaining;
+		m_referenceRepeat.body = state.repeat.body;
+		m_referenceRepeat.opcode = state.repeat.opcode;
+		m_referenceRepeat.extension = state.repeat.extension;
+		m_referenceRepeat.next = state.repeat.next;
+		m_referenceRepeat.loaded = state.repeat.loaded;
+		m_referenceRepeat.savedLC.var = state.repeat.savedLC;
+		m_instructions = state.instructions;
+		m_cycles = state.cycles;
+		m_processingMode = state.mode;
+		m_interruptFunc = state.interruptFunc;
+		pcCurrentInstruction = state.currentPC;
+		m_srCurrentInstruction = state.currentSR;
+		m_opWordB = state.extension;
+		m_currentOpLen = state.opLength;
+		m_referenceMode = state.referenceMode;
+		m_referenceLongEntry = state.longEntry;
