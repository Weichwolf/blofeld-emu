+		state.repeat.remaining = m_referenceRepeat.remaining;
+		state.repeat.body = m_referenceRepeat.body;
+		state.repeat.opcode = m_referenceRepeat.opcode;
+		state.repeat.extension = m_referenceRepeat.extension;
+		state.repeat.next = m_referenceRepeat.next;
+		state.repeat.loaded = m_referenceRepeat.loaded;
+		state.repeat.savedLC = m_referenceRepeat.savedLC.var;
+		state.instructions = m_instructions;
+		state.cycles = m_cycles;
+		state.mode = m_processingMode;
+		state.interruptFunc = m_interruptFunc;
+		state.currentPC = pcCurrentInstruction;
+		state.currentSR = m_srCurrentInstruction;
+		state.extension = m_opWordB;
+		state.opLength = m_currentOpLen;
+		state.referenceMode = m_referenceMode;
+		state.longEntry = m_referenceLongEntry;
+		state.repeatCompleted = m_referenceRepeatCompleted;
+		for(size_t i = 0; i < perif.size(); ++i) state.peripheralTargets[i] = perif[i]->getTargetClock();
