+
+	bool DSP::referenceInterruptible(const TWord nextOpcode) const
+	{
+		if(m_referenceRepeat.remaining || m_referenceVectorActive) return false;
+		if(!m_referenceRepeatCompleted) return true;
+		Instruction a, b;
+		m_opcodes.getInstructionTypes(nextOpcode, a, b);
+		return a < Rep_ea || a > Rep_S;
+	}
+
+	void DSP::execReferenceVectorWord(const TWord address, const TWord opcode, const unsigned available)
+	{
+		Instruction a, b;
+		m_opcodes.getInstructionTypes(opcode, a, b);
+		const auto length = m_opcodes.getOpcodeLength(opcode, a, b);
+		const bool branch = (m_opcodes.getFlags(a, b) & OpFlagBranch) != 0;
+		if(!length || length > available || (branch && a != Jsr_ea && a != Jsr_xxx) ||
+			(a >= Do_ea && a <= Enddo) ||
+			(a >= Rep_ea && a <= Reset) || a == Rti || a == Rts || a == Stop || a == Wait ||
+			a == Trap || a == Trapcc || a == Debug || a == Debugcc || a == Illegal)
+			throw std::runtime_error("Unsupported reference interrupt vector instruction");
+		pcCurrentInstruction = address;
+		m_srCurrentInstruction = getSR().toWord();
+		execOp(opcode);
+	}
+
+	void DSP::execReferenceInterrupt(const TWord vector, const unsigned level)
+	{
