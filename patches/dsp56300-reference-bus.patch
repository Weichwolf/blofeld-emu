+	// Reference bit operations preserve symbolic untouched GPIO bits. Other
+	// peripherals retain one normal read and, for RMW, one normal write.
+	template <Instruction Inst> bool DSP::referenceBitMemory(const TWord op, const PeripheralBitOp action)
+	{
+		const auto bit = getBit<Inst>(op);
+		if(bit >= 24) throw std::runtime_error("Invalid reference DSP bit index");
+		const auto area = getFieldValueMemArea<Inst>(op);
+		TWord address;
+		if constexpr(hasFields<Inst, Field_MMM, Field_RRR>()) {
+			const auto mode = (getFieldValue<Inst, Field_MMM>(op) << 3) | getFieldValue<Inst, Field_RRR>(op);
+			if(mode == MMMRRR_ImmediateData)
+				throw std::runtime_error("Invalid immediate reference bit operand");
+			address = effectiveAddress<Inst>(op);
+		} else if constexpr(hasFieldT<Inst, Field_pppppp>()) {
+			address = 0xffffc0 | getFieldValue<Inst, Field_pppppp>(op);
+		} else if constexpr(hasFieldT<Inst, Field_qqqqqq>()) {
+			address = 0xffff80 | getFieldValue<Inst, Field_qqqqqq>(op);
+		} else {
+			address = getFieldValue<Inst, Field_aaaaaa>(op);
+		}
+		const bool peripheral = isPeripheralAddress(address);
+		if(peripheral) {
+			bool old = false;
+			if(getPeriph(area)->bitAccess(address, bit, action, old)) return old;
+		}
+		auto value = peripheral ? memReadPeriph(area, address, Inst) : memRead(area, address);
+		const auto mask = TWord(1) << bit;
+		const bool old = (value & mask) != 0;
+		switch(action) {
+		case PeripheralBitOp::Test: return old;
+		case PeripheralBitOp::Clear: value &= ~mask; break;
+		case PeripheralBitOp::Set: value |= mask; break;
+		case PeripheralBitOp::Change: value ^= mask; break;
+		default: throw std::runtime_error("Invalid reference bit operation");
+		}
+		if(peripheral) memWritePeriph(area, address, value);
+		else memWrite(area, address, value);
+		return old;
+	}
+
